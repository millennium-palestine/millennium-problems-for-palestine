set_option maxHeartbeats 4000000 in
theorem main : ∀ (K : Type) [Field K] [DecidableEq K] (W : WeierstrassCurve K) [W.IsElliptic] (x : K),
    (2 : K) ≠ 0 → (3 : K) ≠ 0 → (5 : K) ≠ 0 →
    3 * x ^ 4 + W.b₂ * x ^ 3 + 3 * W.b₄ * x ^ 2 + 3 * W.b₆ * x + W.b₈ = 0 →
    (W.preΨ' 5).eval x ≠ 0 := by
  intro K _ _ W _ x h2 _ _ hΨ
  have hΔ : W.Δ ≠ 0 := W.isUnit_Δ.ne_zero
  set v : K := (2 : K)⁻¹ with hvdef
  have hv : 2 * v = 1 := mul_inv_cancel₀ h2
  have hv4 : 4 * v ^ 2 = 1 := by linear_combination (2 * v + 1) * hv
  have hb8 : W.b₈ = (W.b₂ * W.b₆ - W.b₄ ^ 2) * v ^ 2 := by
    linear_combination v ^ 2 * W.b_relation - W.b₈ * hv4
  have hΔF : W.Δ = -(W.b₂ ^ 3 * W.b₆ - W.b₂ ^ 2 * W.b₄ ^ 2 - 36 * W.b₂ * W.b₄ * W.b₆ + 32 * W.b₄ ^ 3 + 108 * W.b₆ ^ 2) * v ^ 2 := by
    unfold WeierstrassCurve.Δ
    rw [hb8]
    linear_combination (-9 * W.b₂ * W.b₄ * W.b₆ + 8 * W.b₄ ^ 3 + 27 * W.b₆ ^ 2) * hv4
  have hv0 : v ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hv
    exact zero_ne_one hv
  -- F ≠ 0, because Δ = −F v² ≠ 0
  have hF0 : (W.b₂ ^ 3 * W.b₆ - W.b₂ ^ 2 * W.b₄ ^ 2 - 36 * W.b₂ * W.b₄ * W.b₆ + 32 * W.b₄ ^ 3 + 108 * W.b₆ ^ 2) ≠ 0 := by
    intro h0
    apply hΔ
    rw [hΔF, h0]
    ring
  rw [hb8] at hΨ
  -- the 5-division polynomial: ψ₅ = preΨ₄ g² − Ψ₃³ (Mathlib preΨ'_odd at m = 0)
  have hpsi5 : (W.preΨ' 5).eval x =
      (2 * x ^ 6 + W.b₂ * x ^ 5 + 5 * W.b₄ * x ^ 4 + 10 * W.b₆ * x ^ 3 + 10 * W.b₈ * x ^ 2 +
          (W.b₂ * W.b₈ - W.b₄ * W.b₆) * x + (W.b₄ * W.b₈ - W.b₆ ^ 2)) *
          (4 * x ^ 3 + W.b₂ * x ^ 2 + 2 * W.b₄ * x + W.b₆) ^ 2 -
        (3 * x ^ 4 + W.b₂ * x ^ 3 + 3 * W.b₄ * x ^ 2 + 3 * W.b₆ * x + W.b₈) ^ 3 := by
    have hodd := W.preΨ'_odd 0
    norm_num at hodd
    rw [hodd]
    simp [WeierstrassCurve.preΨ₄, WeierstrassCurve.Ψ₂Sq, WeierstrassCurve.Ψ₃]
  rw [hb8] at hpsi5
  have hg : 4 * x ^ 3 + W.b₂ * x ^ 2 + 2 * W.b₄ * x + W.b₆ ≠ 0 := by
    intro h0
    have h := gcase_zero W.b₂ W.b₄ W.b₆ x v hv hΨ h0
    rcases mul_eq_zero.mp h with h' | h'
    · exact hF0 (pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h')
    · exact hv0 (pow_eq_zero_iff (n := 4) (by norm_num) |>.mp h')
  have hpre : 2 * x ^ 6 + W.b₂ * x ^ 5 + 5 * W.b₄ * x ^ 4 + 10 * W.b₆ * x ^ 3 + 10 * ((W.b₂ * W.b₆ - W.b₄ ^ 2) * v ^ 2) * x ^ 2 +
      (W.b₂ * ((W.b₂ * W.b₆ - W.b₄ ^ 2) * v ^ 2) - W.b₄ * W.b₆) * x +
      (W.b₄ * ((W.b₂ * W.b₆ - W.b₄ ^ 2) * v ^ 2) - W.b₆ ^ 2) ≠ 0 := by
    intro h0
    have h := pcase_zero W.b₂ W.b₄ W.b₆ x v hv hΨ h0
    rcases mul_eq_zero.mp h with h' | h'
    · exact hF0 (pow_eq_zero_iff (n := 4) (by norm_num) |>.mp h')
    · exact hv0 (pow_eq_zero_iff (n := 8) (by norm_num) |>.mp h')
  rw [hpsi5, hΨ, show ∀ a : K, a - (0 : K) ^ 3 = a from fun a => by simp]
  exact mul_ne_zero hpre (pow_ne_zero 2 hg)

