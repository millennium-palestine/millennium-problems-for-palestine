theorem main : ∀ (K : Type) [Field K] (W : WeierstrassCurve K) [W.IsElliptic],
    (2 : K) = 0 → (5 : K) ≠ 0 → Squarefree (W.preΨ' 5) := by
  intro K _ W _ h2 _
  have hb2 : W.b₂ = W.a₁ ^ 2 := by
    unfold WeierstrassCurve.b₂
    linear_combination (2 * W.a₂) * h2
  have hb4 : W.b₄ = W.a₁ * W.a₃ := by
    unfold WeierstrassCurve.b₄
    linear_combination W.a₄ * h2
  have hb6 : W.b₆ = W.a₃ ^ 2 := by
    unfold WeierstrassCurve.b₆
    linear_combination (2 * W.a₆) * h2
  have hΔ : W.Δ = -W.a₁ ^ 4 * W.b₈ + W.a₁ ^ 3 * W.a₃ ^ 3 - 27 * W.a₃ ^ 4 := by
    unfold WeierstrassCurve.Δ
    rw [hb2, hb4, hb6]
    ring
  have hu : IsUnit W.Δ := W.isUnit_Δ
  have hD : -W.a₁ ^ 4 * W.b₈ + W.a₁ ^ 3 * W.a₃ ^ 3 - 27 * W.a₃ ^ 4 ≠ 0 := by
    rw [← hΔ]
    exact hu.ne_zero
  have key : W.preΨ' 5 = (2 * X ^ 6 + C W.a₁ ^ 2 * X ^ 5 + 5 * (C W.a₁ * C W.a₃) * X ^ 4 + 10 * C W.a₃ ^ 2 * X ^ 3 + 10 * C W.b₈ * X ^ 2 + (C W.a₁ ^ 2 * C W.b₈ - C W.a₁ * C W.a₃ * C W.a₃ ^ 2) * X + (C W.a₁ * C W.a₃ * C W.b₈ - C W.a₃ ^ 4)) * (4 * X ^ 3 + C W.a₁ ^ 2 * X ^ 2 + 2 * (C W.a₁ * C W.a₃) * X + C W.a₃ ^ 2) ^ 2 - (3 * X ^ 4 + C W.a₁ ^ 2 * X ^ 3 + 3 * (C W.a₁ * C W.a₃) * X ^ 2 + 3 * C W.a₃ ^ 2 * X + C W.b₈) ^ 3 := by
    rw [MPP.Solutions.Bsd283.main K W]
    simp only [WeierstrassCurve.preΨ₄, WeierstrassCurve.Ψ₂Sq, WeierstrassCurve.Ψ₃, hb2, hb4, hb6,
      map_pow, map_mul, map_sub, map_add, map_neg, map_ofNat]
    ring
  obtain ⟨U, V, hUV⟩ := cert h2 W.a₁ W.a₃ W.b₈ (W.preΨ' 5) key
  refine MPP.Solutions.Bsd282.main K _ U V _ ?_ hUV
  exact pow_ne_zero _ hD

