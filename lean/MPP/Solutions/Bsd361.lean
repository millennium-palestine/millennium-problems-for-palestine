    (F.map (algebraMap (MvPolynomial (Fin 2) ℤ) (FractionRing (MvPolynomial (Fin 2) ℤ)))) (by rw [hF]; simp)
  rw [← e1, key]
  simp only [map_mul, map_pow, map_add, map_sub, map_ofNat]

set_option maxHeartbeats 4000000 in
theorem main_core (K : Type) [Field K] (W : WeierstrassCurve K) (h1 : W.a₁ = 0) (h2 : W.a₂ = 0)
    (h3 : W.a₃ = 0) :
    (W.preΨ' 5).resultant (derivative (W.preΨ' 5)) 12 11 = (5 : K) ^ 12 * W.Δ ^ 22 := by
  let ψ : MvPolynomial (Fin 2) ℤ →ₐ[ℤ] K := MvPolynomial.aeval ![W.a₄, W.a₆]
  have hmap : ((32 * (X ^ 6 + 5 * C (MvPolynomial.X 0) * X ^ 4 + 20 * C (MvPolynomial.X 1) * X ^ 3 - 5 * C ((MvPolynomial.X 0) ^ 2) * X ^ 2 - 4 * C ((MvPolynomial.X 0) * (MvPolynomial.X 1)) * X - C ((MvPolynomial.X 0) ^ 3) - 8 * C ((MvPolynomial.X 1) ^ 2)) * (X ^ 3 + C (MvPolynomial.X 0) * X + C (MvPolynomial.X 1)) ^ 2 - (3 * X ^ 4 + 6 * C (MvPolynomial.X 0) * X ^ 2 + 12 * C (MvPolynomial.X 1) * X - C ((MvPolynomial.X 0) ^ 2)) ^ 3 : (MvPolynomial (Fin 2) ℤ)[X])).map ψ.toRingHom = W.preΨ' 5 := by
    rw [preΨ5_formula K W h1 h2 h3]
    simp [ψ]
  have e := resultant_map_map (32 * (X ^ 6 + 5 * C (MvPolynomial.X 0) * X ^ 4 + 20 * C (MvPolynomial.X 1) * X ^ 3 - 5 * C ((MvPolynomial.X 0) ^ 2) * X ^ 2 - 4 * C ((MvPolynomial.X 0) * (MvPolynomial.X 1)) * X - C ((MvPolynomial.X 0) ^ 3) - 8 * C ((MvPolynomial.X 1) ^ 2)) * (X ^ 3 + C (MvPolynomial.X 0) * X + C (MvPolynomial.X 1)) ^ 2 - (3 * X ^ 4 + 6 * C (MvPolynomial.X 0) * X ^ 2 + 12 * C (MvPolynomial.X 1) * X - C ((MvPolynomial.X 0) ^ 2)) ^ 3 : (MvPolynomial (Fin 2) ℤ)[X]) (derivative (32 * (X ^ 6 + 5 * C (MvPolynomial.X 0) * X ^ 4 + 20 * C (MvPolynomial.X 1) * X ^ 3 - 5 * C ((MvPolynomial.X 0) ^ 2) * X ^ 2 - 4 * C ((MvPolynomial.X 0) * (MvPolynomial.X 1)) * X - C ((MvPolynomial.X 0) ^ 3) - 8 * C ((MvPolynomial.X 1) ^ 2)) * (X ^ 3 + C (MvPolynomial.X 0) * X + C (MvPolynomial.X 1)) ^ 2 - (3 * X ^ 4 + 6 * C (MvPolynomial.X 0) * X ^ 2 + 12 * C (MvPolynomial.X 1) * X - C ((MvPolynomial.X 0) ^ 2)) ^ 3 : (MvPolynomial (Fin 2) ℤ)[X])) 12 11 ψ.toRingHom
  rw [← derivative_map, hmap] at e
  rw [e, main_R (MvPolynomial.X 0) (MvPolynomial.X 1) rfl rfl _ rfl]
  simp [ψ, discr_Δ K W h1 h2 h3]
  all_goals norm_num

theorem main : ∀ (K : Type) [Field K] (W : WeierstrassCurve K),
    W.a₁ = 0 → W.a₂ = 0 → W.a₃ = 0 →
    (W.preΨ' 5).resultant (Polynomial.derivative (W.preΨ' 5)) 12 11 = (5 : K) ^ 12 * W.Δ ^ 22 := by
  intro K _ W h1 h2 h3
  exact main_core K W h1 h2 h3

