open Polynomial

theorem transfer_step (K : Type) [Field K] (A B S Q : K[X]) (c g : K) (m n : ℕ)
    (hQ : Q.natDegree + n ≤ m) (hB : B.natDegree ≤ n)
    (h : C c * A = Q * B + C g * S) :
    c ^ n * A.resultant B m n = g ^ n * S.resultant B m n := by
  have h1 : (C c * A).resultant B m n = (C g * S).resultant B m n := by
    rw [h, add_comm, mul_comm Q B, resultant_add_mul_left _ _ _ _ _ hQ hB]
  rw [← resultant_C_mul_left, h1, resultant_C_mul_left]

theorem step_lemma (K : Type) [Field K] (A B S Q : K[X]) (c g : K) (m n n' : ℕ)
    (hQ : Q.natDegree + n ≤ m) (hB : B.natDegree ≤ n) (hS : S.natDegree ≤ n') (hm : n' ≤ m)
    (h : C c * A = Q * B + C g * S) :
    c ^ n * A.resultant B m n =
      g ^ n * ((-1) ^ (m * n) * B.coeff n ^ (m - n') * B.resultant S n n') := by
  rw [transfer_step K A B S Q c g m n hQ hB h, resultant_comm S B m n]
  obtain ⟨k, rfl⟩ : ∃ k, m = n' + k := ⟨m - n', by omega⟩
  rw [Nat.add_sub_cancel_left, resultant_add_right_deg B S n n' k hS]
  ring

theorem link (K : Type) [Field K] (A B S : K[X]) (c g : K) (n n' : ℕ)
    (hB : B.natDegree ≤ n) (hS : S.natDegree ≤ n') (hn : n' ≤ n + 1)
    (hQ : ∃ Q : K[X], Q.natDegree ≤ 1 ∧ C c * A = Q * B + C g * S) :
    c ^ n * A.resultant B (n + 1) n = g ^ n * (B.coeff n ^ (n + 1 - n') * B.resultant S n n') := by
  obtain ⟨Q, hQd, h⟩ := hQ
  have hQ' : Q.natDegree + n ≤ n + 1 := by omega
  have hev : Even ((n + 1) * n) := by rw [mul_comm]; exact Nat.even_mul_succ_self n
  rw [step_lemma K A B S Q c g (n + 1) n n' hQ' hB hS (by omega) h, hev.neg_one_pow]
  ring

