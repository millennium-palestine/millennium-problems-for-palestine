theorem main : ∀ (K : Type) [Field K] (W : WeierstrassCurve K) [W.IsElliptic],
    (3 : K) = 0 → (5 : K) ≠ 0 → W.a₁ = 0 → W.a₃ = 0 → Squarefree (W.preΨ' 5) := by
  intro K _ W _ h3 _ ha1 ha3
  have hb2 : W.b₂ = 4 * W.a₂ := by simp [WeierstrassCurve.b₂, ha1]
  have hb4 : W.b₄ = 2 * W.a₄ := by simp [WeierstrassCurve.b₄, ha1, ha3]
  have hb6 : W.b₆ = 4 * W.a₆ := by simp [WeierstrassCurve.b₆, ha3]
  have hb8 : W.b₈ = 4 * W.a₂ * W.a₆ - W.a₄ ^ 2 := by simp [WeierstrassCurve.b₈, ha1, ha3]
  have hΔ : W.Δ = (-(64 * W.a₂ ^ 3 * W.a₆) + 16 * W.a₂ ^ 2 * W.a₄ ^ 2 - 64 * W.a₄ ^ 3 - 432 * W.a₆ ^ 2 + 288 * W.a₂ * W.a₄ * W.a₆) := by
    unfold WeierstrassCurve.Δ
    rw [hb2, hb4, hb6, hb8]
    ring
  have hu : IsUnit W.Δ := W.isUnit_Δ
  have hD : ((-(64 * W.a₂ ^ 3 * W.a₆) + 16 * W.a₂ ^ 2 * W.a₄ ^ 2 - 64 * W.a₄ ^ 3 - 432 * W.a₆ ^ 2 + 288 * W.a₂ * W.a₄ * W.a₆)) ^ 5 ≠ 0 := by
    rw [← hΔ]
    exact pow_ne_zero _ hu.ne_zero
  have key : W.preΨ' 5 = (2 * X ^ 6 + (4 * C W.a₂) * X ^ 5 + 5 * (2 * C W.a₄) * X ^ 4 + 10 * (4 * C W.a₆) * X ^ 3 + 10 * (4 * C W.a₂ * C W.a₆ - C W.a₄ ^ 2) * X ^ 2 + ((4 * C W.a₂) * (4 * C W.a₂ * C W.a₆ - C W.a₄ ^ 2) - (2 * C W.a₄) * (4 * C W.a₆)) * X + ((2 * C W.a₄) * (4 * C W.a₂ * C W.a₆ - C W.a₄ ^ 2) - (4 * C W.a₆) ^ 2)) * (4 * X ^ 3 + (4 * C W.a₂) * X ^ 2 + 2 * (2 * C W.a₄) * X + 4 * C W.a₆) ^ 2 - (3 * X ^ 4 + (4 * C W.a₂) * X ^ 3 + 3 * (2 * C W.a₄) * X ^ 2 + 3 * (4 * C W.a₆) * X + (4 * C W.a₂ * C W.a₆ - C W.a₄ ^ 2)) ^ 3 := by
    rw [MPP.Solutions.Bsd283.main K W]
    simp only [WeierstrassCurve.preΨ₄, WeierstrassCurve.Ψ₂Sq, WeierstrassCurve.Ψ₃, hb2, hb4, hb6,
      hb8, map_pow, map_mul, map_sub, map_add, map_neg, map_ofNat, map_zero]
  obtain ⟨U, V, hUV⟩ := cert h3 W.a₂ W.a₄ W.a₆ (W.preΨ' 5) key
  exact MPP.Solutions.Bsd282.main K _ U V _ hD hUV

