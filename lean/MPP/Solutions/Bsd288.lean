def chk : List Term := mulL LA LF ++ mulL LB LG ++ scaleL (-1) LC


theorem ev_append {R : Type} [CommRing R] (x a b : R) (l1 l2 : List Term) :
    ev x a b (l1 ++ l2) = ev x a b l1 + ev x a b l2 := by
  induction l1 with
  | nil => simp [ev]
  | cons t l ih =>
    obtain ⟨c, i, j, k⟩ := t
    simp only [List.cons_append, ev, ih]
    ring

theorem ev_addT {R : Type} [CommRing R] (x a b : R) (t : Term) (L : List Term) :
    ev x a b (addT t L) = ev x a b (t :: L) := by
  induction L with
  | nil =>
    obtain ⟨c, i, j, k⟩ := t
    simp [addT, ev]
  | cons s L ih =>
    obtain ⟨c, i, j, k⟩ := t
    obtain ⟨c', i', j', k'⟩ := s
    unfold addT
    split_ifs with h
    · obtain ⟨rfl, rfl, rfl⟩ := h
      simp only [ev]
      push_cast
      ring
    · simp only [ev] at ih ⊢
      rw [ih]
      ring

theorem ev_normalize {R : Type} [CommRing R] (x a b : R) (l : List Term) :
    ev x a b (normalize l) = ev x a b l := by
  induction l with
  | nil => simp [normalize, ev]
  | cons t l ih =>
    simp only [normalize]
    rw [ev_addT]
    simp only [ev, ih]

theorem ev_zero_of_zeroCoeffs {R : Type} [CommRing R] (x a b : R) (l : List Term)
    (h : zeroCoeffs l = true) : ev x a b l = 0 := by
  induction l with
  | nil => simp [ev]
  | cons t l ih =>
    obtain ⟨c, i, j, k⟩ := t
    have h' : c = 0 ∧ zeroCoeffs l = true := by simpa [zeroCoeffs] using h
    simp only [ev]
    rw [ih h'.2, h'.1]
    simp

theorem ev_mulRow {R : Type} [CommRing R] (x a b : R) (t : Term) (l2 : List Term) :
    ev x a b (mulRow t l2) = ev x a b [t] * ev x a b l2 := by
  induction l2 with
  | nil => simp [mulRow, ev]
  | cons s l ih =>
    obtain ⟨c, i, j, k⟩ := t
    obtain ⟨c', i', j', k'⟩ := s
    simp only [mulRow, ev, ih, mulT]
    push_cast
    ring

theorem ev_mul {R : Type} [CommRing R] (x a b : R) (l1 l2 : List Term) :
    ev x a b (mulL l1 l2) = ev x a b l1 * ev x a b l2 := by
  induction l1 with
  | nil => simp [mulL, ev]
  | cons t l ih =>
    simp only [mulL, ev_append, ev_mulRow, ih, ev]
    ring

theorem ev_scale {R : Type} [CommRing R] (x a b : R) (s : ℤ) (l : List Term) :
    ev x a b (scaleL s l) = (s : R) * ev x a b l := by
  induction l with
  | nil => simp [scaleL, ev]
  | cons t l ih =>
    obtain ⟨c, i, j, k⟩ := t
    simp only [scaleL, ev, ih]
    push_cast
    ring


