set_option maxRecDepth 100000 in
theorem cofactor_exists {R : Type} [CommRing R] (x a b F G : R)
    (hF : F = (2 * x ^ 6 + 10 * a * x ^ 4 + 40 * b * x ^ 3 - 10 * a ^ 2 * x ^ 2 - 8 * a * b * x - 2 * a ^ 3 - 16 * b ^ 2) * (4 * x ^ 3 + 4 * a * x + 4 * b) ^ 2 - (3 * x ^ 4 + 6 * a * x ^ 2 + 12 * b * x - a ^ 2) ^ 3)
    (hG : G = -100*a^5*x - 100*a^4*b - 500*a^4*x^3 - 240*a^3*b*x^2 - 1800*a^3*x^5 - 480*a^2*b^2*x - 3480*a^2*b*x^4 - 840*a^2*x^7 - 640*a*b^3 - 7680*a*b^2*x^3 + 1680*a*b*x^6 + 620*a*x^9 - 4800*b^3*x^2 - 1440*b^2*x^5 + 3420*b*x^8 + 60*x^11) :
    ∃ A B : R, A * F + B * G = 5 ^ 12 * (-64 * a ^ 3 - 432 * b ^ 2) ^ 22 := by
  have hF': F = ev x a b LF := by
    rw [hF]
    simp only [LF, ev]
    push_cast
    ring
  have hG' : G = ev x a b LG := by
    rw [hG]
    simp only [LG, ev]
    push_cast
    ring
  have hC : (5 : R) ^ 12 * (-64 * a ^ 3 - 432 * b ^ 2) ^ 22 = ev x a b LC := by
    simp only [LC, ev]
    push_cast
    ring
  have key : ev x a b chk = ev x a b LA * ev x a b LF + ev x a b LB * ev x a b LG - ev x a b LC := by
    simp only [chk, ev_append, ev_mul, ev_scale]
    push_cast
    ring
  have hz : zeroCoeffs (normalize chk) = true := by decide +kernel
  have h0 := ev_zero_of_zeroCoeffs x a b _ hz
  rw [ev_normalize, key] at h0
  refine ⟨ev x a b LA, ev x a b LB, ?_⟩
  rw [hF', hG', hC]
  linear_combination h0


