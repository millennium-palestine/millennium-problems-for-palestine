/-! Certificate check by kernel evaluation.
A term (c, i, j, k) stands for c * x^i * a^j * b^k. Lists of terms are
evaluated by `ev`; `normalize` merges equal monomials, and the kernel checks
(by `decide`) that the merged difference has all coefficients zero. -/

abbrev Term := ℤ × ℕ × ℕ × ℕ

def ev {R : Type} [CommRing R] (x a b : R) : List Term → R
  | [] => 0
  | (c, i, j, k) :: l => (c : R) * x ^ i * a ^ j * b ^ k + ev x a b l

def addT : Term → List Term → List Term
  | (c, i, j, k), [] => [(c, i, j, k)]
  | (c, i, j, k), (c', i', j', k') :: l =>
    if i = i' ∧ j = j' ∧ k = k' then (c + c', i, j, k) :: l
    else (c', i', j', k') :: addT (c, i, j, k) l

def normalize : List Term → List Term
  | [] => []
  | t :: l => addT t (normalize l)

def zeroCoeffs (l : List Term) : Bool := l.all (fun t => t.1 == 0)

def mulT (t s : Term) : Term :=
  (t.1 * s.1, t.2.1 + s.2.1, t.2.2.1 + s.2.2.1, t.2.2.2 + s.2.2.2)

def mulRow (t : Term) : List Term → List Term
  | [] => []
  | s :: l => mulT t s :: mulRow t l

def mulL : List Term → List Term → List Term
  | [], _ => []
  | t :: l1, l2 => mulRow t l2 ++ mulL l1 l2

def scaleL (s : ℤ) : List Term → List Term
  | [] => []
  | (c, i, j, k) :: l => (s * c, i, j, k) :: scaleL s l

