set_option maxHeartbeats 400000 in
theorem main : ∀ (K : Type) [Field K] (W : WeierstrassCurve K),
    W.a₁ = 0 → W.a₂ = 0 → W.a₃ = 0 →
    ∃ A B : Polynomial K,
      A * W.preΨ' 5 + B * Polynomial.derivative (W.preΨ' 5) = Polynomial.C ((5 : K) ^ 12 * W.Δ ^ 22) := by
  intro K _ W h1 h2 h3
  have hpre : W.preΨ' 5 = W.preΨ₄ * W.Ψ₂Sq ^ 2 - W.Ψ₃ ^ 3 := by
    rw [show (5 : ℕ) = 2 * (0 + 2) + 1 from rfl, WeierstrassCurve.preΨ'_odd]
    simp [WeierstrassCurve.preΨ'_one, WeierstrassCurve.preΨ'_two, WeierstrassCurve.preΨ'_three,
      WeierstrassCurve.preΨ'_four, pow_three]
  have hb2 : W.b₂ = 0 := by simp [WeierstrassCurve.b₂, h1, h2]
  have hb4 : W.b₄ = 2 * W.a₄ := by simp [WeierstrassCurve.b₄, h1, h3]
  have hb6 : W.b₆ = 4 * W.a₆ := by simp [WeierstrassCurve.b₆, h3]
  have hb8 : W.b₈ = -W.a₄ ^ 2 := by simp [WeierstrassCurve.b₈, h1, h2, h3]
  have hΔ : W.Δ = -64 * W.a₄ ^ 3 - 432 * W.a₆ ^ 2 := by
    unfold WeierstrassCurve.Δ
    rw [hb2, hb4, hb6, hb8]
    ring
  obtain ⟨A, B, h⟩ := cofactor_exists Polynomial.X (Polynomial.C W.a₄) (Polynomial.C W.a₆)
    (W.preΨ' 5) (Polynomial.derivative (W.preΨ' 5))
    (by
      rw [hpre]
      simp only [WeierstrassCurve.preΨ₄, WeierstrassCurve.Ψ₃, WeierstrassCurve.Ψ₂Sq, hb2, hb4, hb6, hb8,
        map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat, map_zero, Polynomial.C_mul]
      ring)
    (by
      rw [hpre]
      simp only [WeierstrassCurve.preΨ₄, WeierstrassCurve.Ψ₃, WeierstrassCurve.Ψ₂Sq, hb2, hb4, hb6, hb8,
        map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat, map_zero, Polynomial.C_mul,
        map_natCast, Nat.cast_ofNat, Polynomial.derivative_mul, Polynomial.derivative_pow, Polynomial.derivative_add,
        Polynomial.derivative_sub, Polynomial.derivative_neg, Polynomial.derivative_X,
        Polynomial.derivative_C, Polynomial.derivative_ofNat]
      ring)
  refine ⟨A, B, h.trans ?_⟩
  rw [hΔ]
  simp only [map_mul, map_pow, map_sub, map_neg, map_ofNat]

